# counter4_clocked in both modes: Clock period 20 (rising edges at 10, 30, 50, ...),
# PowerOnReset released at tick 45. Times count from power-on in both modes; Fast mode samples
# at the end of the phase containing each target tick.
cycle 4                   # tick 69: edges 10 and 30 in reset, edge 50 counts
expect Q=1 rst=0
mode fast                 # compile; state carried over from Timing mode
cycle 1                   # tick 89
expect Q=2
cycle 10                  # tick 289
expect Q=12 clk=0
mode timing
cycle 2                   # tick 329
expect Q=14
mode fast
run 30                    # target 359: end of the phase [350, 359]
expect Q=0 clk=1
reset                     # power on again (Fast mode: at the end of the first phase)
cycle 4                   # tick 69 again
expect Q=1
