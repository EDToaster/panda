# counter4 driven by a Clock (period 40, rising at tick 20) and a PowerOnReset of 90 ticks.
expect Q=x clk=0 rst=1
run 28                    # first rising edge at tick 20; Q is reset a few ticks later
expect Q=0 clk=1
run 72                    # tick 100: reset released at 90, rising edge now
expect rst=0
run 20                    # tick 120
expect Q=1 clk=0
run 400                   # tick 520: 10 more rising edges (140, 180, ..., 500)
expect Q=11
print Q cnt/next
